<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Lesson Table</title>
</head>
<body>

<h2>Sample Table</h2>

<table border="1" cellpadding="10">
    <tr>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Grade</th>
    </tr>
    <tr>
        <td>John</td>
        <td>Smith</td>
        <td>9</td>
    </tr>
    <tr>
        <td>Sarah</td>
        <td>Lee</td>
        <td>10</td>
    </tr>
    <tr>
        <td>Marcus</td>
        <td>Brown</td>
        <td>11</td>
    </tr>
</table>

</body>
</html>
